<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The UI is WPF (see Wpf/ and Themes/). WindowsForms stays
         referenced only for the tray icon (NotifyIcon, which WPF lacks)
         and the System.Drawing it needs. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\skull.ico</ApplicationIcon>
    <!-- Asks Windows for administrator rights at launch — see the manifest
         for why remapping into a game needs it. DPI mode is declared here
         rather than in that manifest, where the WinForms toolchain
         objects to it. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <StartupObject>UnboundKeys.Program</StartupObject>
    <Company>Built by Fizzil^.^</Company>
    <Version>4.0.1</Version>
    <!-- The exe's own filename carries the version (UnboundKeys-v1.0.0.exe),
         staying in sync automatically on every future bump. RootNamespace
         is pinned separately so embedded resource lookups (Assets\skull.*)
         keep working regardless of what AssemblyName becomes — otherwise
         it would default to matching AssemblyName and break them. -->
    <AssemblyName>UnboundKeys-v$(Version)</AssemblyName>
    <RootNamespace>UnboundKeys</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vosk: offline, small-vocabulary speech recognition — replaces the
         built-in Windows System.Speech engine, which couldn't reliably tell
         "press one" apart from ordinary talk. NAudio captures raw microphone
         audio and feeds it to Vosk (Vosk itself has no capture of its own). -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="NAudio" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- skull.ico is the window/taskbar icon (ApplicationIcon above) and
         the tray icon, which TrayIcon.cs loads from this resource. -->
    <EmbeddedResource Include="Assets\skull.ico" />
    <!-- The on-screen keyboard's word-suggestion list (see WordPredictor). -->
    <EmbeddedResource Include="Assets\words-en.txt" />
    <!-- The Voice page's illustration (see Wpf/VoiceDiagram) — black line
         art on white, turned into a tintable mask at load time. -->
    <EmbeddedResource Include="Assets\voice-profile.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Vosk model is a folder of data files, not a single assembly, so
         it's copied to sit next to the exe rather than embedded in it —
         PublishSingleFile bundles managed assemblies, not arbitrary data
         trees like this. VoiceEngine.cs resolves it relative to the running
         exe's own folder at startup. -->
    <None Include="VoskModel\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>