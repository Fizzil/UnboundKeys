<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same RGB values as Theme.cs's Blue preset (WinForms) — see
         Theme.Red.xaml for why these three files stay in lockstep on key
         names. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#FF121212"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3C8CE6"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FF0F2846"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF275B96"/>

</ResourceDictionary>
