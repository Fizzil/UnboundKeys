<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:themes="clr-namespace:UnboundKeys.Themes">

    <!-- The value every "this is the active/selected/armed one" trigger
         below compares Tag against. Code sets Tag to a real bool
         (button.Tag = true); Tag itself is typed object, so a trigger
         written as Value="True" keeps the TEXT "True" and never matches a
         bool — none of those triggers fired until this existed. A typed
         Boolean resource is the one way to spell a bool in a trigger. -->
    <sys:Boolean x:Key="TagOn">True</sys:Boolean>

    <!-- How long a hover/press color fade takes — named once so every
         button's timing stays in lockstep if it ever needs tuning. -->
    <Duration x:Key="HoverFadeDuration">0:0:0.15</Duration>
    <Duration x:Key="PressFadeDuration">0:0:0.08</Duration>

    <!-- Flat, gently-rounded base every button style below builds on. WPF's
         stock Button chrome (3D bevel, dotted focus rectangle, square
         corners) doesn't match this app's look, so this replaces the whole
         ControlTemplate instead of just overriding Background/Foreground
         the way a WinForms FlatStyle.Flat button could get away with.
         Colors are DynamicResource, not StaticResource, so swapping the
         merged color dictionary (Theme.Red/Green/Blue.xaml) re-themes
         every button live — see those files' own comment.

         Three behaviors are wired into this ONE shared template rather
         than duplicated per style:
         - Hover/press feedback, animated via HoverFadeBehavior.cs, not a
           declarative Storyboard here — see that file's own comment for
           why: a Storyboard living in a shared ControlTemplate has to be
           frozen for reuse across every button using the style, and that
           freeze fails outright once any animated value is a
           DynamicResource (needed so the fade always targets whichever
           color theme is CURRENTLY active). The named "BgBrush" element
           below is what that behavior animates.
         - Soft corners (CornerRadius) instead of hard rectangles.
         - An optional bottom underline, shown when Tag="True" — the WPF
           equivalent of Theme.cs's EnableTabUnderline/SetTabSelected pair
           (WinForms: Tag held the selected bool and a Paint handler drew
           the bar; here a Trigger on the same Tag property reveals a
           Border already sitting in the template). Harmless for buttons
           that never set Tag — it just never triggers.

         Focusable="False" on this and every other root button style: the
         dashboard is used with a mouse only and its windows never take
         keyboard focus (NoActivateWindow), so a button holding focus would
         only ever produce a stray focus rectangle. -->
    <Style x:Key="FlatButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="themes:HoverFadeBehavior.Enable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <SolidColorBrush x:Name="BgBrush" Color="{DynamicResource ButtonColor}"/>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Underline"
                                Height="2"
                                CornerRadius="1"
                                VerticalAlignment="Bottom"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-width list row — Repeat/Hold/Reset, a category button, "Add
         Key". MakeListButton's equivalent. -->
    <Style x:Key="ListButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- The top-level tab strip's own buttons (Mouse Keys/Keyboard/Voice
         Keys/Profile/Fade) — a small gap between each so they read as
         discrete buttons, but no border anymore (Fizzil's new standing
         rule: move away from red outlines everywhere, embrace shade-based
         depth instead, closer to how Discord/VS Code mark an active tab —
         FlatButtonBase's own underline-on-Tag plus its hover fill already
         carry the "which one is selected" signal without a border doing
         double duty).

         Foreground is overridden here rather than left at FlatButtonBase's
         own TextPrimaryBrush default — Discord dims every inactive
         channel name to gray and only lights up the one that's actually
         open (plus whatever's under the cursor); without this every tab
         read equally bright all the time. Tag="True" means "this is the
         open tab" (see DashboardShell.xaml.cs's OpenPrimeTab).

         Own ControlTemplate rather than FlatButtonBase's shared one — a
         Discord-style selected channel keeps a lighter PILL BEHIND IT
         permanently, not just while hovered, and FlatButtonBase's own
         Bg fill is owned by HoverFadeBehavior (which always fades back
         to ButtonColor on MouseLeave, so a Tag-based persistent color
         there would just get erased the moment the mouse left). A plain,
         un-animated Setter trigger on Tag doesn't have that problem — so
         this style skips HoverFadeBehavior entirely (harmless either way:
         Wire() no-ops when it can't find a "BgBrush" part, but turning it
         off here is more honest about what's actually driving this
         template) and reacts to hover/selection with plain Setters,
         same pattern as SecondaryButtonStyle. No underline anymore for
         this one specifically — the persistent pill fill already carries
         that signal, so keeping both would be redundant. -->
    <Style x:Key="TabStripButtonStyle" TargetType="Button" BasedOn="{StaticResource ListButtonStyle}">
        <Setter Property="Margin" Value="2"/>
        <!-- Smaller than FlatButtonBase's default 16 — at full size these
             read as too bright/loud for what's essentially page
             navigation, not the main action being taken (Fizzil's own
             feedback: "too bright and bolded"). -->
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="themes:HoverFadeBehavior.Enable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                        </Trigger>
                        <!-- The persistent pill — stays filled even after
                             the mouse moves away, as long as this is the
                             open tab. -->
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource TagOn}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The ONE bold action in a given context — Discord/VS Code's own
         "primary button" pattern: solid Accent fill, dark text for
         contrast, used sparingly rather than as the default for every
         button (Fizzil's new standing rule — make this app feel like a
         sibling to those two, not a wall of identically-loud buttons). -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8,16,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Everything else — Discord/VS Code's own "ghost button" pattern:
         no fill and no border at rest, quiet Muted text, and on hover a
         soft Elevated-shade fill plus brighter text — depth and "what's
         interactive" communicated by shade and motion, not an outline.
         Replaces TabStripButtonStyle's border for in-card actions
         (Repeat/Hold/Reset and similar) per Fizzil's own new standing
         rule. Still supports the Tag="True" underline for a toggled-on
         state (Repeat/Hold), same mechanism as FlatButtonBase's. A
         genuinely separate template, not FlatButtonBase-based — that one
         always fills with ButtonColor at rest, which is exactly the
         "everything looks the same weight" problem this style exists to
         fix. -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Underline"
                                Height="2"
                                CornerRadius="1"
                                VerticalAlignment="Bottom"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <!-- Toggled-on (Repeat/Hold's own "this is currently
                             active") is the one place this style keeps
                             AccentBrush — an active-state signal, not just a
                             hover, so it's the exception to the neutral text
                             everywhere else in this style. -->
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact square-ish button — +1, .1, the reset glyph, Infinite.
         MakeTinyButton's equivalent. -->
    <Style x:Key="TinyButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
        <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- The non-interactive label half of a label/value row ("Key 1" next
         to its value) — full accent, left-aligned, no hover/press
         feedback since only the value side is clickable. A TextBlock, not
         a Button — there's nothing to click. MakeLabelDisplay's
         equivalent. -->
    <Style x:Key="LabelDisplayStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="12,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- A row shown nested under the one it belongs to — Reset All under
         Reset — full accent and still a real command, just indented so it
         reads as part of the row above it. MakeNestedButton's equivalent. -->
    <Style x:Key="NestedButtonStyle" TargetType="Button" BasedOn="{StaticResource ListButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="28,0,0,0"/>
    </Style>

    <!-- A row in a plain scrolling list (the key picker's own individual
         keys, "A"/"B"/"C"/...) — quiet Muted text at rest, brighter on
         hover, same reasoning as CategoryNavButtonStyle below (which now
         builds on this) — a long list of same-sized rows needs a hover
         cue beyond just FlatButtonBase's background fade, or it's hard to
         tell which row the mouse is actually over. The Foreground Trigger
         is a plain Style trigger, not touching HoverFadeBehavior's
         animated background fade at all — the two run independently, so
         hovering gets both a highlighted background AND brighter text. -->
    <Style x:Key="QuietListButtonStyle" TargetType="Button" BasedOn="{StaticResource ListButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The category nav list (Letters, Numbers, ...) next to a key's
         split-view key picker — QuietListButtonStyle's own quiet-at-rest/
         brighter-on-hover text, just left-aligned instead of centered. -->
    <Style x:Key="CategoryNavButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietListButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,0,0,0"/>
    </Style>

    <!-- A small bordered "chip" button — no fill at rest, just an outline,
         sized to fit its own text rather than stretching to fill its
         cell. Used for Mouse Keys' row value ("Not Mapped", "A", ...) —
         Fizzil's own feedback on ValueButtonStyle there: it read as one
         large gray highlight block behind the whole column, not a neat
         little button. A genuinely separate template rather than a
         FlatButtonBase-based style, since FlatButtonBase's whole premise
         (an always-filled background that animates color on hover) is
         the opposite of what "no fill at rest" needs — a plain Setter-
         based hover here is fine; it doesn't hit the frozen-Storyboard
         issue HoverFadeBehavior exists for since there's no DynamicResource
         inside an animation here, just a plain trigger Setter. -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,4,10,4"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <!-- "This is the one currently expanded/open" —
                             RemapCard's Key value uses this instead of
                             FlatButtonBase's underline (which ValueButtonStyle
                             relied on) now that its value chip is an
                             OutlineButtonStyle, not a filled ValueButtonStyle
                             one. A thin accent border reads as "active"
                             against the chip's own plain Elevated fill,
                             even though this style otherwise has no border. -->
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A section heading, like "Folder pictures" in the Windows folder-
         properties dialog Fizzil pointed at — a small caption naming a
         group of related rows, with a thin rule underneath separating it
         from the group's own content. Muted, not full accent, since it's
         naming the group rather than acting as a command — same
         "muted = secondary" language as everywhere else in this file. -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="4,0,0,4"/>
    </Style>

    <!-- The thin rule under a SectionHeaderStyle heading — a plain 1px
         line, not a full row, so a group of rows reads as visually
         gathered under its own heading rather than just floating above
         it. -->
    <Style x:Key="SectionRuleStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- A toggle that shows on/off by fully inverting its colors instead
         of an underline — the confirm-delete "✕"'s armed state, the Reset
         button's tap-flash. Its own template rather than reusing
         FlatButtonBase's Tag trigger, since that one means "show an
         underline" — this Tag means something visually different (a full
         color swap), so it gets a second small template rather than
         overloading one Tag with two meanings. Still animated/rounded the
         same way. SetToggleAppearance's equivalent.

         Foreground starts at TextSecondaryBrush (dim), not FlatButtonBase's
         own TextPrimaryBrush default — a bare "✕" icon button reads as too
         loud/attention-grabbing sitting bright white at rest next to
         everything else that's gone neutral this pass; Discord's own
         low-emphasis icon buttons (a remove/close glyph) stay muted until
         hovered or, here, armed via Tag. -->
    <Style x:Key="ToggleFillButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="4">
                            <Border.Background>
                                <SolidColorBrush x:Name="BgBrush" Color="{DynamicResource ButtonColor}"/>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== The Discord-style shell (left rail + pages) ===== -->

    <!-- One item of the left navigation rail (Mouse / Voice / Keyboard /
         Settings) — Discord's channel-list row: left-aligned, dim text at
         rest, a persistent Elevated pill plus bright text on the open one
         (Tag="True", set by DashboardShell). Its own template rather than
         FlatButtonBase's for the same reason TabStripButtonStyle has one:
         HoverFadeBehavior owns that fill and would erase the pill on
         MouseLeave. -->
    <Style x:Key="NavRailButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="8,2,8,2"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource TagOn}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A labeled on/off switch row (Listening, Fade) — Discord's own
         settings toggle: label on the left, a small pill track with a
         sliding knob on the right. Tag="True" means on: the track turns
         Accent and the knob slides right. A Button rather than a
         CheckBox so it gets the same left-click, never-focusable handling
         as everything else here. -->
    <Style x:Key="RailToggleStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="8,0,8,0"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10"
                                    Background="{DynamicResource HoverBrush}" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left" Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The rail footer's profile chip — Discord's bottom-left user panel:
         a quiet filled strip naming the current profile, lighter on hover
         and while its flyout is open (Tag="True"). -->
    <Style x:Key="ProfileChipStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="8,4,8,4"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A theme-color swatch (Settings → THEME): a filled circle in that
         theme's own accent — set per instance via Background, since only
         the ACTIVE theme's AccentBrush exists as a resource — with a
         TextPrimary ring around the selected one (Tag="True") and a
         fainter ring on hover. -->
    <Style x:Key="SwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Opacity="0"/>
                        <Ellipse Width="30" Height="30" Fill="{TemplateBinding Background}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One key of the on-screen letter grid (renaming a profile) — a
         FlatButtonBase key at keyboard-like proportions: filled, big
         text, small gaps, 44px tall so it's an easy mouse target. -->
    <Style x:Key="LetterKeyStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- The content area's page title ("Mouse", "Right Button", ...) and
         the rail's app name — HeadingBrush, a soft white (see
         Theme.Red.xaml's own comment); the theme color sits beside the
         text, not in it. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The editor page's "‹ Back" — a ghost button sitting left of the
         title. -->
    <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- The window's own minimize / close, top-right of the page header —
         Segoe MDL2's chrome glyphs on a ghost button. -->
    <Style x:Key="WindowButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>

    <!-- ===== Settings-row pieces used inside the editor card ===== -->

    <!-- The label on the left of a "label … control" row. -->
    <Style x:Key="RowLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

    <!-- One quiet line of explanation under a row. -->
    <Style x:Key="RowHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="12,0,12,8"/>
    </Style>

    <!-- The second line inside a toggle row's own label (RailToggleStyle
         content) — its own Foreground so it stays quiet when the row's
         label brightens. -->
    <Style x:Key="InlineHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- A row's current value ("1.5 s"), read at a glance. -->
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- A small filled text button that nudges a value: "+0.1 s", "+1 s",
         "Reset". Filled (FlatButtonBase) rather than ghost so a row of
         them reads as buttons, and labeled in words rather than the old
         "1" / ".1" / ↻ glyphs, which read as a puzzle (Fizzil's own
         feedback). -->
    <Style x:Key="StepButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
    </Style>

    <!-- A segmented control (Tap | Repeat | Hold): the group is a filled
         rounded strip, the chosen segment a lighter pill inside it — the
         same depth ladder as everything else, one step each. -->
    <Style x:Key="SegmentGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SegmentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two-click remove button on a Key 2/3 row or a profile row: a
         quiet ✕ at rest; the first click arms it (ConfirmDeleteBehavior
         sets Tag) and it turns into an accent "Remove?", so the second
         click is an informed one. Content and Width live in this style,
         not on the instance, so the trigger can swap them — a value set
         on the instance would outrank the trigger. -->
    <Style x:Key="RemoveButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="✕"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="4,0,8,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource TagOn}">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                            <Setter Property="Content" Value="Remove?"/>
                            <Setter Property="Width" Value="96"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
