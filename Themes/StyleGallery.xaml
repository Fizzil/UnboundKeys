<Window x:Class="UnboundKeys.Themes.StyleGallery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase 2 style gallery — Theme.Controls.xaml preview"
        Width="420" SizeToContent="Height"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.Red.xaml"/>
                <ResourceDictionary Source="Theme.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">

        <TextBlock Text="ListButtonStyle (Repeat/Hold/Reset)" Foreground="#666" FontSize="11" Margin="0,0,0,2"/>
        <Button Content="Repeat" Height="40" Style="{StaticResource ListButtonStyle}"/>
        <Button Content="Hold" Height="40" Margin="0,1,0,0" Style="{StaticResource ListButtonStyle}"/>

        <TextBlock Text="ListButtonStyle, Tag=True (tab-underline selected)" Foreground="#666" FontSize="11" Margin="0,10,0,2"/>
        <Button Content="Repeat (on)" Height="40" Tag="True" Style="{StaticResource ListButtonStyle}"/>

        <TextBlock Text="Label / Value split row" Foreground="#666" FontSize="11" Margin="0,10,0,2"/>
        <Grid Height="40" Tag="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Key 1" Style="{StaticResource LabelDisplayStyle}"/>
            <Button Grid.Column="1" Content="A" HorizontalContentAlignment="Right"
                    Style="{StaticResource ValueButtonStyle}" Tag="True"/>
        </Grid>

        <TextBlock Text="NestedButtonStyle (category row, Reset All)" Foreground="#666" FontSize="11" Margin="0,10,0,2"/>
        <Button Content="Letters" Height="40" Style="{StaticResource NestedButtonStyle}"/>

        <TextBlock Text="TinyButtonStyle row (timing row buttons)" Foreground="#666" FontSize="11" Margin="0,10,0,2"/>
        <UniformGrid Rows="1" Height="40">
            <Button Content="1" Style="{StaticResource TinyButtonStyle}"/>
            <Button Content=".1" Style="{StaticResource TinyButtonStyle}"/>
            <Button Content="&#8635;" Style="{StaticResource TinyButtonStyle}"/>
            <Button Content="&#8734;" Tag="True" Style="{StaticResource TinyButtonStyle}"/>
        </UniformGrid>

        <TextBlock Text="ToggleFillButtonStyle (confirm-delete armed / reset flash)" Foreground="#666" FontSize="11" Margin="0,10,0,2"/>
        <UniformGrid Rows="1" Columns="2" Height="40">
            <Button Content="&#10005; (not armed)" Style="{StaticResource ToggleFillButtonStyle}"/>
            <Button Content="&#10005; (armed)" Tag="True" Style="{StaticResource ToggleFillButtonStyle}"/>
        </UniformGrid>

    </StackPanel>
</Window>
