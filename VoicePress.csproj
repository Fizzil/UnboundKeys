    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\skull.ico</ApplicationIcon>
    <StartupObject>VoicePress.Program</StartupObject>
    <Company>Built by Fizzil^.^</Company>
    <Version>1.0.0</Version>
