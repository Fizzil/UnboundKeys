<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\skull.ico</ApplicationIcon>
    <StartupObject>VoicePress.Program</StartupObject>
    <Company>Built by Fizzil^.^</Company>
    <Version>1.6.1</Version>
    <!-- The exe's own filename carries the version (VoicePress-v1.0.0.exe),
         staying in sync automatically on every future bump. RootNamespace
         is pinned separately so embedded resource lookups (Assets\skull.*)
         keep working regardless of what AssemblyName becomes — otherwise
         it would default to matching AssemblyName and break them. -->
    <AssemblyName>VoicePress-v$(Version)</AssemblyName>
    <RootNamespace>VoicePress</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vosk: offline, small-vocabulary speech recognition — replaces the
         built-in Windows System.Speech engine, which couldn't reliably tell
         "press one" apart from ordinary talk. NAudio captures raw microphone
         audio and feeds it to Vosk (Vosk itself has no capture of its own). -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="NAudio" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\skull.png" />
    <EmbeddedResource Include="Assets\skull.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Vosk model is a folder of data files, not a single assembly, so
         it's copied to sit next to the exe rather than embedded in it —
         PublishSingleFile bundles managed assemblies, not arbitrary data
         trees like this. VoiceEngine.cs resolves it relative to the running
         exe's own folder at startup. -->
    <None Include="VoskModel\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>