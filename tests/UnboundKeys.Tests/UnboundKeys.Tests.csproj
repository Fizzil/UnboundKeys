<Project Sdk="Microsoft.NET.Sdk">

  <!-- A harness in three parts. Timing: it runs the real KeyExecutor with
       a keyboard hook timing every key it sends, and checks the Infinite
       pause and Rotation against the plan. Settings: profiles, sub-profiles,
       older files and damaged files, in a scratch folder. Updater: the
       download's fingerprint check, against a server on this machine.
       Run it with dotnet run, project tests/UnboundKeys.Tests, Release
       (nothing on the desktop reacts to the F13 to F15 keys it sends, and
       the real settings file is never touched). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UnboundKeys.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UnboundKeys.csproj" />
  </ItemGroup>

</Project>
