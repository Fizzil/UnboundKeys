<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="UnboundKeys.app"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Run elevated: a game that runs as administrator (or behind
             anti-cheat) ignores key presses sent by an ordinary process,
             and a low-level hook installed by one never sees that game's
             mouse or keyboard input either — so every remap needs the app
             elevated. Windows asks once at launch (the UAC prompt, which
             a mouse can answer). -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- No DPI settings here on purpose: the WinForms toolchain (still
       referenced for the tray icon) wants them in the project file
       (ApplicationHighDpiMode) rather than in a manifest, and WPF is
       system-DPI-aware by default anyway. -->
</assembly>
