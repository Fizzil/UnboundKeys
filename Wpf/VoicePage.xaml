<UserControl x:Class="UnboundKeys.Wpf.VoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnboundKeys.Wpf">
    <!-- The picture on the left, the ten words as a keypad on the right
         with the always-available commands beneath. Hovering a tile
         lights the waves; clicking it opens that word editor. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <local:VoiceDiagram x:Name="Diagram" Width="190" VerticalAlignment="Top" Margin="4,12,20,0"/>
        <StackPanel x:Name="Rows" Grid.Column="1"/>
    </Grid>
</UserControl>
