<UserControl x:Class="UnboundKeys.Wpf.VoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnboundKeys.Wpf">
    <!-- The picture on the left, one row per spoken word on the right —
         1 to 10 top-to-bottom, in reading order. Hovering a row shows its
         key on the drawn key; clicking it opens that word's editor. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <local:VoiceDiagram x:Name="Diagram" Width="190" VerticalAlignment="Top" Margin="4,12,20,0"/>
        <StackPanel x:Name="Rows" Grid.Column="1"/>
    </Grid>
</UserControl>
