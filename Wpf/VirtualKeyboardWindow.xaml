<uk:NoActivateWindow x:Class="UnboundKeys.Wpf.VirtualKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uk="clr-namespace:UnboundKeys"
        Title="UnboundKeys keyboard"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <!-- The on-screen keyboard: its own always-on-top window that never
         takes focus (NoActivateWindow), so every key goes to whatever the
         game is. A grip strip down the left edge drags it — a tall target
         that's easy to hit with a mouse — and the rows are built in code
         (see Row1..Row5 / MiniRow). AllowsTransparency for Fade's dimming
         and the rounded corners. -->
    <Border x:Name="Root" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="780"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ButtonBrush}" CornerRadius="7,0,0,7" Cursor="SizeAll"
                    ToolTip="Drag to move the keyboard" MouseLeftButtonDown="Grip_MouseLeftButtonDown">
                <TextBlock Text="&#x22EE;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <StackPanel x:Name="FullLayout" Grid.Column="1" Margin="4">
                <!-- Word suggestions for the word in progress (see
                     WordPredictor) — a fixed-height strip, kept even when
                     empty so the keys never jump. Only for the full layout:
                     the Mini strip has no letters to type with. -->
                <UniformGrid x:Name="SuggestionRow" Rows="1" Height="34" Margin="0,0,0,4"/>
            </StackPanel>
            <StackPanel x:Name="MiniLayout" Grid.Column="1" Margin="4" Visibility="Collapsed"/>
        </Grid>
    </Border>
</uk:NoActivateWindow>
