<uk:NoActivateWindow x:Class="UnboundKeys.Wpf.VirtualKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uk="clr-namespace:UnboundKeys"
        Title="UnboundKeys keyboard"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <!-- The on-screen keyboard: its own always-on-top window that never
         takes focus (NoActivateWindow), so every key goes to whatever the
         game is. A grip strip down the RIGHT edge drags it — a tall target
         that's easy to hit, and right next to Mini/Maxi, so collapsing,
         expanding and moving all happen in one corner without the mouse
         travelling (Fizzil's ergonomics call). The rows are built in code
         from KeyboardLayout. AllowsTransparency for Fade's dimming and
         the rounded corners. -->
    <Border x:Name="Root" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="780"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="{DynamicResource ButtonBrush}" CornerRadius="0,7,7,0" Cursor="SizeAll"
                    ToolTip="Drag to move the keyboard" MouseLeftButtonDown="Grip_MouseLeftButtonDown">
                <TextBlock Text="&#x22EE;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <StackPanel x:Name="FullLayout" Grid.Column="0" Margin="4">
                <!-- Word suggestions for the word in progress (see
                     WordPredictor) — a key-height strip, kept even when
                     empty so the keys never jump, with its right corner
                     given to the Menu, Fade and Mini keys: 1/17 of the width
                     each, the same cells Menu, Fade and Maxi have in the
                     collapsed strip, so they sit in exactly the same spot
                     in both layouts (see KeyboardLayout.MenuKey/FadeKey/MiniKey).
                     Only for the full layout: the Mini strip has no
                     letters to type with. -->
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <UniformGrid x:Name="SuggestionRow" Rows="1"/>
                    <ContentControl x:Name="MenuKeyHost" Grid.Column="1"/>
                    <ContentControl x:Name="FadeKeyHost" Grid.Column="2"/>
                    <ContentControl x:Name="MiniKeyHost" Grid.Column="3"/>
                </Grid>
            </StackPanel>
            <StackPanel x:Name="MiniLayout" Grid.Column="0" Margin="4" Visibility="Collapsed"/>
        </Grid>
    </Border>
</uk:NoActivateWindow>
