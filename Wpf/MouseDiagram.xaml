<UserControl x:Class="UnboundKeys.Wpf.MouseDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A simple top-down mouse, drawn rather than an image so it re-themes
         with everything else: a rounded body, the two main buttons (left
         dimmed — it's the one button that can never be remapped, since a
         left click on the overlay icon is the guaranteed way into this
         dashboard), the wheel as three hotspots (scroll up / press / scroll
         down), and the two thumb-side buttons. Hotspot fills are set in
         code so the highlight can follow the mouse and the row list. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="300">
            <Rectangle Canvas.Left="20" Canvas.Top="10" Width="160" Height="280" RadiusX="80" RadiusY="100"
                       Fill="{DynamicResource ButtonBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1.5"/>

            <Canvas>
                <Canvas.Clip>
                    <RectangleGeometry Rect="20,10,160,280" RadiusX="80" RadiusY="100"/>
                </Canvas.Clip>
                <Rectangle x:Name="LeftButton" Canvas.Left="20" Canvas.Top="10" Width="76" Height="140"
                           Fill="{DynamicResource ButtonBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1"
                           ToolTip="Left click always opens UnboundKeys, so it can't be remapped"/>
                <Rectangle x:Name="RightButton" Canvas.Left="104" Canvas.Top="10" Width="76" Height="140"
                           Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Cursor="Hand"/>
            </Canvas>

            <Rectangle x:Name="WheelUp" Canvas.Left="88" Canvas.Top="30" Width="24" Height="34" RadiusX="6" RadiusY="6"
                       Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Cursor="Hand"/>
            <Rectangle x:Name="WheelMiddle" Canvas.Left="88" Canvas.Top="68" Width="24" Height="44" RadiusX="6" RadiusY="6"
                       Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Cursor="Hand"/>
            <Rectangle x:Name="WheelDown" Canvas.Left="88" Canvas.Top="116" Width="24" Height="34" RadiusX="6" RadiusY="6"
                       Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Cursor="Hand"/>
            <TextBlock Canvas.Left="94" Canvas.Top="38" Text="&#x25B2;" FontSize="11" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Canvas.Left="94" Canvas.Top="124" Text="&#x25BC;" FontSize="11" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Rectangle x:Name="SideForward" Canvas.Left="4" Canvas.Top="150" Width="18" Height="36" RadiusX="4" RadiusY="4"
                       Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Cursor="Hand"/>
            <Rectangle x:Name="SideBack" Canvas.Left="4" Canvas.Top="192" Width="18" Height="36" RadiusX="4" RadiusY="4"
                       Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" Cursor="Hand"/>
        </Canvas>
    </Viewbox>
</UserControl>
