<UserControl x:Class="UnboundKeys.Wpf.DashboardShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnboundKeys.Wpf"
             xmlns:themes="clr-namespace:UnboundKeys.Themes"
             Background="{DynamicResource BackgroundBrush}">
    <!-- Discord's own shape: a fixed rail on the left, one page on the
         right, the page's header (title, or "‹ Back" + title while an
         editor is open) above a body that scrolls by hovering its edges
         (no wheel — a remapped wheel is swallowed by the mouse hook even
         over this window; no scrollbar — a small target that never
         matched the theme). Fills whatever window hosts it; the window
         itself is the fixed 720×540. -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <local:NavRail x:Name="Rail" Grid.Column="0"/>
        <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{DynamicResource CardBorderBrush}"/>

        <Grid Grid.Column="1" Margin="16,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The header doubles as the window's title bar: the whole top
                 strip (this and the rail's name plate) drags the window —
                 see OnPreviewMouseLeftButtonDown — and the two chrome
                 buttons top-right minimize and close it. -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="‹ Back" Style="{StaticResource BackButtonStyle}"
                            Visibility="Collapsed" Click="BackButton_Click"/>
                    <!-- The theme color beside the title rather than in it. -->
                    <Border Width="3" Height="18" CornerRadius="1.5" Margin="0,0,10,0" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" ToolTip="Minimize" Click="Minimize_Click"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}" ToolTip="Close" Click="Close_Click"/>
                </StackPanel>
                <Border Style="{StaticResource SectionRuleStyle}" Margin="0" VerticalAlignment="Bottom"/>
            </Grid>

            <ScrollViewer x:Name="Body" Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          themes:EdgeAutoScrollBehavior.Enable="True">
                <ContentControl x:Name="PageHost" Margin="0,8,0,8" HorizontalContentAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>

        <!-- The profile chip's flyout — Discord's user-panel popout: an
             in-window layer rather than a second window (no DPI math, no
             focus questions), rising from the rail's bottom edge over the
             footer. The transparent catcher behind it spans the whole
             shell, so a click anywhere else simply closes it. -->
        <Grid x:Name="FlyoutLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="Transparent" MouseLeftButtonDown="FlyoutDismiss_Click"/>
            <Border Width="220" MaxHeight="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="8,0,0,8" CornerRadius="8" Padding="6"
                    Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SWITCH PROFILE" Style="{StaticResource SectionHeaderStyle}" Margin="10,4,0,4"/>
                    <StackPanel x:Name="FlyoutList"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
