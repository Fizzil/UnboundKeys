<Window x:Class="UnboundKeys.Wpf.DashboardShellPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase 6 preview — DashboardShell"
        Width="600" SizeToContent="Height"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <StackPanel x:Name="Root" Margin="20">
        <TextBlock Text="Real tabs, real cards. Click Voice Keys, switch between 10..1, open Profile."
                   Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
    </StackPanel>
</Window>
