<UserControl x:Class="UnboundKeys.Wpf.NavRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Discord's channel list, for this app: the app's own name up top,
         the four sections as labeled rows (a glyph from Segoe MDL2 Assets
         — the icon font every Windows 10/11 install ships with — plus
         text, so nothing has to be guessed from an icon alone), and a
         footer that stays put whichever page is open: the profile chip
         and the two global switches. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Margin="20,0,12,0" VerticalAlignment="Center">
                <!-- A two-tone wordmark: "Keys" carries the theme color. -->
                <TextBlock Style="{StaticResource PageTitleStyle}"><Run Text="Unbound"/><Run Text="Keys" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <Border Style="{StaticResource SectionRuleStyle}" Margin="12,0,12,0" VerticalAlignment="Bottom"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,6,0,0">
            <Button x:Name="MouseButton" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Mouse" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="VoiceButton" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Voice" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="KeyboardButton" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Keyboard" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource NavRailButtonStyle}" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Border Style="{StaticResource SectionRuleStyle}" Margin="12,0,12,6"/>
            <Button x:Name="ProfileChip" Style="{StaticResource ProfileChipStyle}" Click="ProfileChip_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="PROFILE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="ProfileNameText" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Button>
            <Button x:Name="ListeningToggle" Content="Listening" Style="{StaticResource RailToggleStyle}" Click="ListeningToggle_Click"/>
            <Button x:Name="FadeToggle" Content="Fade" Style="{StaticResource RailToggleStyle}" Click="FadeToggle_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
