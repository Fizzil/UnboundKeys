<UserControl x:Class="UnboundKeys.Wpf.LetterGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mouse-only text entry for a profile name: what's been spelled so
         far, a 9×4 grid of letter and digit keys, then Space / Backspace /
         Cancel / Done. Replaces the typed TextBox the old profile list
         used — the one place in the app that needed a keyboard, and the
         reason the old dashboard had to take keyboard focus (and so could
         steal it from a game). -->
    <StackPanel>
        <Grid Height="44" Margin="2,0,2,6">
            <Border CornerRadius="6" Background="{DynamicResource ElevatedBrush}"/>
            <TextBlock x:Name="PlaceholderText" Text="Spell a name with the keys below" FontSize="13"
                       Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="PreviewText" Style="{StaticResource PageTitleStyle}" Margin="14,0,0,0"/>
        </Grid>
        <UniformGrid x:Name="KeyGrid" Columns="9"/>
        <Grid Height="48" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SpaceKey" Content="Space" Style="{StaticResource LetterKeyStyle}"/>
            <Button x:Name="BackspaceKey" Grid.Column="1" Content="&#x232B;  Backspace" Width="140" Style="{StaticResource LetterKeyStyle}"/>
            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Width="90" Height="44" Margin="10,2,0,2" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="DoneButton" Grid.Column="3" Content="Done" Width="90" Height="44" Margin="6,2,2,2" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </StackPanel>
</UserControl>
