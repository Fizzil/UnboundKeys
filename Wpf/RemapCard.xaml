<UserControl x:Class="UnboundKeys.Wpf.RemapCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="370">
    <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" CornerRadius="8"
            Effect="{StaticResource CardShadow}">
        <StackPanel Margin="1">

            <!-- Key 1, plus "Add Key" and up to two extra keys — all built
                 dynamically in code (see RebuildKeyGroup) since the count
                 varies. Each key gets its own label/value row (only the
                 value side clickable, matching RemapCardTab's own
                 BuildKeyLabelRow) and its own animated category list
                 directly beneath it. -->
            <StackPanel x:Name="KeyGroup"/>

            <!-- Blank gap between the Key group and the action row —
                 same idea as RemapCardTab's own keyRepeatGap (WinForms):
                 a plain spacer, not another row, so the card reads as
                 two distinct sections instead of one continuous grid. -->
            <Border Height="8" Background="Transparent"/>

            <!-- Repeat / Hold / Reset share one row — see RemapCardTab's
                 own comment on why (matches the reference layout Fizzil
                 pointed at: short actions grouped, not stacked as three
                 full-width bars). -->
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RepeatButton" Grid.Column="0" Content="Repeat" Click="RepeatButton_Click" Style="{StaticResource ListButtonStyle}"/>
                <Button x:Name="HoldButton" Grid.Column="1" Content="Hold" Click="HoldButton_Click" Style="{StaticResource ListButtonStyle}"/>
                <Button x:Name="ResetButton" Grid.Column="2" Content="Reset" Click="ResetButton_Click" Style="{StaticResource ListButtonStyle}"/>
            </Grid>

            <!-- The timing row: duration first and biggest (it's the one
                 piece of information here), then the +1/+0.1/reset
                 cluster that adjusts it, then a plain spacer, then
                 Infinite set apart on its own since it replaces the whole
                 idea of a duration rather than adjusting it — same layout
                 as RemapCardTab's own timingPanel (WinForms), shown only
                 while Repeat or Hold is on, animated open/closed the same
                 way the category lists are. -->
            <Grid x:Name="TimingPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="18*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DurationText" Grid.Column="0" Foreground="{DynamicResource MutedBrush}"
                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="PlusOneButton" Grid.Column="1" Content="1" Click="PlusOneButton_Click" Style="{StaticResource TinyButtonStyle}"/>
                <Button x:Name="PlusTenthButton" Grid.Column="2" Content=".1" Click="PlusTenthButton_Click" Style="{StaticResource TinyButtonStyle}"/>
                <Button x:Name="ResetDurationButton" Grid.Column="3" Content="&#8635;" Click="ResetDurationButton_Click" Style="{StaticResource TinyButtonStyle}"/>
                <Border Grid.Column="4" Background="Transparent"/>
                <Button x:Name="InfiniteButton" Grid.Column="5" Content="&#8734;" Click="InfiniteButton_Click" Style="{StaticResource TinyButtonStyle}"/>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
