<UserControl x:Class="UnboundKeys.Wpf.RemapCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="440">
    <!-- CardBorderBrush (a near-white tone with just a hint of the accent
         color), not MutedBrush — Fizzil's own request: a plain color
         change on the outline itself, not another glow. No Effect here
         either anymore — CardShadow's blur was rendering the whole card
         (SecondaryButtonStyle's now-transparent Repeat/Hold/Reset
         included) with a soft "fuzzy" look Fizzil flagged, not a clean
         edge glow the way it read on an opaque card. -->
    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Margin="1">

            <!-- Key 1, plus "Add Key" and up to two extra keys — all built
                 dynamically in code (see RebuildKeyGroup) since the count
                 varies. Each key gets its own label/value row (only the
                 value side clickable, matching RemapCardTab's own
                 BuildKeyLabelRow) and its own animated category list
                 directly beneath it. -->
            <StackPanel x:Name="KeyGroup"/>

            <!-- Blank gap between the Key group and the action row —
                 same idea as RemapCardTab's own keyRepeatGap (WinForms):
                 a plain spacer, not another row, so the card reads as
                 two distinct sections instead of one continuous grid. -->
            <Border Height="8" Background="Transparent"/>

            <!-- Repeat / Hold / Reset share one row — see RemapCardTab's
                 own comment on why (matches the reference layout Fizzil
                 pointed at: short actions grouped, not stacked as three
                 full-width bars). SecondaryButtonStyle — Discord/VS
                 Code's own "ghost button" pattern (Fizzil's new standing
                 rule): quiet at rest, an Elevated-shade fill on hover,
                 no border. Not PrimaryButtonStyle — none of these three
                 is the one bold action in this card. -->
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RepeatButton" Grid.Column="0" Content="Repeat" Click="RepeatButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="HoldButton" Grid.Column="1" Content="Hold" Click="HoldButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="ResetButton" Grid.Column="2" Content="Reset" Click="ResetButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>

            <!-- The timing row: duration first and biggest (it's the one
                 piece of information here), then the +1/+0.1/reset
                 cluster that adjusts it, then a plain spacer, then
                 Infinite set apart on its own since it replaces the whole
                 idea of a duration rather than adjusting it — same layout
                 as RemapCardTab's own timingPanel (WinForms), shown only
                 while Repeat or Hold is on, animated open/closed the same
                 way the category lists are. -->
            <Grid x:Name="TimingPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="18*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DurationText" Grid.Column="0" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="PlusOneButton" Grid.Column="1" Content="1" Click="PlusOneButton_Click" Style="{StaticResource TinyButtonStyle}"/>
                <Button x:Name="PlusTenthButton" Grid.Column="2" Content=".1" Click="PlusTenthButton_Click" Style="{StaticResource TinyButtonStyle}"/>
                <Button x:Name="ResetDurationButton" Grid.Column="3" Content="&#8635;" Click="ResetDurationButton_Click" Style="{StaticResource TinyButtonStyle}"/>
                <Border Grid.Column="4" Background="Transparent"/>
                <Button x:Name="InfiniteButton" Grid.Column="5" Content="&#8734;" Click="InfiniteButton_Click" Style="{StaticResource TinyButtonStyle}"/>
            </Grid>

            <!-- Repeat Interval: only shown while Repeat is on for a card
                 with 2+ keys — a plain toggle, no value of its own.
                 Turning it on reveals KeyIntervalRow below (one K button
                 per key, built dynamically since the count varies — see
                 RebuildKeyIntervalRow). Matches RemapCardTab's own
                 repeatIntervalButton/keyIntervalRowPanel (WinForms). -->
            <Button x:Name="RepeatIntervalButton" Content="Repeat Interval" Height="0" Visibility="Collapsed"
                    Click="RepeatIntervalButton_Click" Style="{StaticResource ListButtonStyle}"/>
            <Grid x:Name="KeyIntervalRow" Height="0" Visibility="Collapsed" ClipToBounds="True"/>

            <!-- Reset All: hidden until the Reset button's own three-rapid-
                 taps easter egg reveals it (see ResetButton_Click) — resets
                 every card, not just this one, once the dashboard shell
                 exists to coordinate that (not part of this slice yet, so
                 for now it just resets this card again). -->
            <Button x:Name="ResetAllButton" Content="Reset All" Height="0" Visibility="Collapsed"
                    Click="ResetAllButton_Click" Style="{StaticResource NestedButtonStyle}"/>

        </StackPanel>
    </Border>
</UserControl>
