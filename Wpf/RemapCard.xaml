<UserControl x:Class="UnboundKeys.Wpf.RemapCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnboundKeys.Wpf"
             MinWidth="440">
    <!-- The editor for one mapping, laid out as rows of "label on the
         left, control on the right" — Discord's settings-page shape —
         instead of the WinForms card's rows of small buttons. Keys first
         (built in code: Key 1, up to five extras with a two-click Remove,
         then "+ Add key"), then how the keys are sent: a Mode switch
         (Tap / Repeat / Hold), the Duration with +0.1 s / +1 s / Reset
         and an Infinite switch while Repeat or Hold is on, then Game mode
         (see below), and Reset at the bottom. Sections that don't apply
         are collapsed and animate open when they do. -->
    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Margin="1,1,1,8">

            <StackPanel x:Name="KeyGroup"/>

            <Border Height="10" Background="Transparent"/>

            <!-- Exactly one of Tap / Repeat / Hold — one segmented control
                 rather than two independent toggles that happened to
                 cancel each other. Tap is "neither Repeat nor Hold" in
                 KeyBehavior terms. -->
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mode" Style="{StaticResource RowLabelStyle}"/>
                <Border Grid.Column="1" Style="{StaticResource SegmentGroupStyle}" Margin="0,0,8,0">
                    <UniformGrid Rows="1" Width="288">
                        <Button x:Name="TapButton" Content="Tap" Click="TapButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                        <Button x:Name="RepeatButton" Content="Repeat" Click="RepeatButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                        <Button x:Name="HoldButton" Content="Hold" Click="HoldButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                    </UniformGrid>
                </Border>
            </Grid>
            <TextBlock x:Name="ModeHint" Style="{StaticResource RowHintStyle}"/>

            <!-- Duration and Infinite: only meaningful while Repeat or Hold
                 is on. Editing the duration switches Infinite off and
                 Infinite clears the duration — the two are alternatives,
                 same rule as the WinForms card. -->
            <StackPanel x:Name="TimingPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Duration" Style="{StaticResource RowLabelStyle}"/>
                    <TextBlock x:Name="DurationText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="PlusTenthButton" Content="+0.1 s" Click="PlusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                        <Button x:Name="PlusOneButton" Content="+1 s" Click="PlusOneButton_Click" Style="{StaticResource StepButtonStyle}"/>
                        <Button x:Name="ResetDurationButton" Content="Reset" Click="ResetDurationButton_Click" Style="{StaticResource StepButtonStyle}"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="InfiniteButton" Click="InfiniteButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Infinite"/>
                        <TextBlock Text="Keeps going until you trigger it again" Style="{StaticResource InlineHintStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Game mode (Fizzil, after a WoW night): the timing a game
                 with a global cooldown needs. One app-wide switch, so it
                 stays on in every editor once a game is being set up. It
                 reveals three switches: the sub-profile's (class's) global
                 cooldown, custom gaps for this mapping alone (Repeat only),
                 and Priority — a mapping that pauses any infinite repeat,
                 waits out the GCD, fires, pauses one more GCD (or a
                 channel's cast time), then lets it resume (see
                 KeyExecutor's priority pause). -->
            <Button x:Name="GameModeButton" Click="GameModeButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Game mode"/>
                    <TextBlock Text="Timing for games with a global cooldown, in every editor" Style="{StaticResource InlineHintStyle}"/>
                </StackPanel>
            </Button>
            <StackPanel x:Name="GamePanel" Height="0" Visibility="Collapsed" ClipToBounds="True">

                <!-- The class's GCD: one value for the whole sub-profile
                     (GameTiming), so it shows the same in every editor.
                     Off = none applied; on = pick a class, or step the
                     number for haste. -->
                <Button x:Name="GcdButton" Click="GcdButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Global cooldown"/>
                        <TextBlock x:Name="GcdHint" Text="One GCD between the keys of every infinite repeat in this sub-profile" Style="{StaticResource InlineHintStyle}"/>
                    </StackPanel>
                </Button>
                <StackPanel x:Name="GcdPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                    <Border Style="{StaticResource SegmentGroupStyle}" Margin="28,2,8,4" HorizontalAlignment="Left">
                        <UniformGrid Rows="1" Width="424">
                            <Button x:Name="GcdMostButton" Content="Most classes · 1.5 s" Click="GcdMostButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                            <Button x:Name="GcdFastButton" Content="Rogue, cat Druid, Monk · 1.0 s" Click="GcdFastButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                        </UniformGrid>
                    </Border>
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Custom" Style="{StaticResource RowLabelStyle}" Margin="28,0,0,0"/>
                        <TextBlock x:Name="GcdText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Content="−0.1 s" Click="GcdMinusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                            <Button Content="+0.1 s" Click="GcdPlusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="GcdOwnerHint" Style="{StaticResource RowHintStyle}" Margin="28,0,12,8"/>
                </StackPanel>

                <!-- Custom gaps: this mapping waits its own time instead of
                     the class GCD — one gap for all its keys, and a row per
                     key when it has several (built in code, since the
                     count varies). Only for Repeat. -->
                <StackPanel x:Name="GapsPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                    <Button x:Name="RepeatIntervalButton" Click="RepeatIntervalButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Custom gaps between keys"/>
                            <TextBlock Text="Its own gap for this mapping instead of the class GCD, per key if you want" Style="{StaticResource InlineHintStyle}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="CustomGapRows" Height="0" Visibility="Collapsed" ClipToBounds="True">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gap between keys" Style="{StaticResource RowLabelStyle}" Margin="28,0,0,0"/>
                            <TextBlock x:Name="RepeatGapText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Content="+0.1 s" Click="GapPlusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                <Button Content="+1 s" Click="GapPlusOneButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                <Button Content="Reset" Click="GapResetButton_Click" Style="{StaticResource StepButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="The wait after every key of this mapping. A key row below can still differ."
                                   Style="{StaticResource RowHintStyle}" Margin="28,0,12,8"/>
                        <StackPanel x:Name="KeyIntervalRows" Height="0" Visibility="Collapsed" ClipToBounds="True"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="PriorityButton" Click="PriorityButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Priority"/>
                        <TextBlock Text="Pauses an infinite repeat, waits for the GCD, fires, pauses one more GCD, then resumes" Style="{StaticResource InlineHintStyle}"/>
                    </StackPanel>
                </Button>
                <StackPanel x:Name="PriorityPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                    <!-- A channel needs its cast time, not one GCD: the switch
                         reveals the pause time only when it applies (Fizzil). -->
                    <Button x:Name="ChannelButton" Click="ChannelButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="20,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Channelled ability"/>
                            <TextBlock Text="Keeps the repeat paused for the cast time below instead of one GCD" Style="{StaticResource InlineHintStyle}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="ChannelPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pause the repeat for" Style="{StaticResource RowLabelStyle}" Margin="28,0,0,0"/>
                            <TextBlock x:Name="PriorityText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Content="+0.1 s" Click="PriorityPlusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                <Button Content="+1 s" Click="PriorityPlusOneButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                <Button Content="Reset" Click="PriorityResetButton_Click" Style="{StaticResource StepButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="How long the channel takes, usually two to three seconds. Reset goes back to 2.5 s."
                                   Style="{StaticResource RowHintStyle}" Margin="28,0,12,8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Experimental assistance (Fizzil): single-button farming
                     with the player at the wheel, the way the game's own
                     Assisted Combat button does a rotation. Farm nearby
                     wraps this mapping's keys (the rotation) in target,
                     wait, loot (see KeyExecutor.RunFarmLoop); the game keys
                     it presses around them belong to the sub-profile
                     (GameTiming). Folded, like the explanations below. -->
                <local:FoldSection x:Name="AssistFold" Title="EXPERIMENTAL ASSISTANCE" Margin="4,0,4,0">
                    <StackPanel Margin="0,2,0,6">
                        <TextBlock Text="Single-button farming with you at the wheel, like the game's own Assisted Combat button but for the whole loop. You start and stop every run, and nothing here watches the screen: the game's soft targeting and Auto Loot do the aiming."
                                   Style="{StaticResource RowHintStyle}" Margin="12,0,12,6"/>

                        <!-- The game keys, once per sub-profile: rows built in
                             code (see RebuildGameKeyRows), each with the key
                             picker beneath it like the mapping's own keys. -->
                        <StackPanel x:Name="GameKeyRows"/>
                        <TextBlock Text="Your game's own keys. In WoW, Target Nearest Enemy is Tab, or a macro key that targets what your mouse is over. For the loot click pick Right Click from the Mouse list: with Click to Move on it runs you to whatever your cursor is on, corpse or mob, and Auto Loot does the rest. The Interact With Target key only reaches a corpse you stand on, and a dead mob drops off target anyway."
                                   Style="{StaticResource RowHintStyle}" Margin="12,2,12,6"/>

                        <Button x:Name="FarmButton" Click="FarmButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Farm nearby"/>
                                <TextBlock Text="Target the nearest enemy, run to it, do the rotation, wait, loot, go again" Style="{StaticResource InlineHintStyle}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="FarmPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                            <!-- The run (Fizzil's own loop: point at a mob, and
                                 the assist targets it, runs to it, kills it, loots
                                 it): the loot click right after Target, then time
                                 for the run before the rotation. Melee needs it; a
                                 hunter can leave it off. -->
                            <Button x:Name="FarmApproachButton" Click="FarmApproachButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="20,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Run to the target first"/>
                                    <TextBlock Text="Runs you into range and starts attacking. Needs the game's Click to Move" Style="{StaticResource InlineHintStyle}"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="FarmApproachPanel" Height="0" Visibility="Collapsed" ClipToBounds="True">
                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time to reach it" Style="{StaticResource RowLabelStyle}" Margin="44,0,0,0"/>
                                    <TextBlock x:Name="FarmApproachText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Content="+0.1 s" Click="FarmApproachPlusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                        <Button Content="+1 s" Click="FarmApproachPlusOneButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                        <Button Content="Reset" Click="FarmApproachResetButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="The run before the rotation starts. Reset goes back to 1.5 s."
                                           Style="{StaticResource RowHintStyle}" Margin="44,0,12,8"/>
                            </StackPanel>
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rotation rounds per mob" Style="{StaticResource RowLabelStyle}" Margin="28,0,0,0"/>
                                <TextBlock x:Name="FarmRoundsText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button Content="−1" Click="FarmRoundsMinusButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                    <Button Content="+1" Click="FarmRoundsPlusButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="How many times the rotation runs before the loop expects the mob to be down."
                                       Style="{StaticResource RowHintStyle}" Margin="28,0,12,8"/>
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Wait for the drop" Style="{StaticResource RowLabelStyle}" Margin="28,0,0,0"/>
                                <TextBlock x:Name="FarmPauseText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button Content="+0.1 s" Click="FarmPausePlusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                    <Button Content="+1 s" Click="FarmPausePlusOneButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                    <Button Content="Reset" Click="FarmPauseResetButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="The pause after the last rotation key before looting. Reset goes back to 2.0 s."
                                       Style="{StaticResource RowHintStyle}" Margin="28,0,12,8"/>
                            <!-- The loot click runs you to the corpse (Click to
                                 Move); this is that run, so the next Target
                                 waits for it. Fizzil's test: Interact only
                                 reaches a corpse you stand on, a right-click
                                 runs you there. -->
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Time to reach the corpse" Style="{StaticResource RowLabelStyle}" Margin="28,0,0,0"/>
                                <TextBlock x:Name="FarmLootText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button Content="+0.1 s" Click="FarmLootPlusTenthButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                    <Button Content="+1 s" Click="FarmLootPlusOneButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                    <Button Content="Reset" Click="FarmLootResetButton_Click" Style="{StaticResource StepButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="The run to the loot after each click, before the next target. Reset goes back to 2.0 s."
                                       Style="{StaticResource RowHintStyle}" Margin="28,0,12,8"/>
                            <Button x:Name="FarmSkinButton" Click="FarmSkinButton_Click" Style="{StaticResource RailToggleStyle}" Height="48" Margin="20,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Skin after loot"/>
                                    <TextBlock Text="A second Interact on the corpse, for Skinning" Style="{StaticResource InlineHintStyle}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="FarmNote" Style="{StaticResource RowHintStyle}" Margin="28,2,12,8"/>
                        </StackPanel>
                    </StackPanel>
                </local:FoldSection>

                <!-- The explanations, where the switches are (Fizzil): a fold
                     row like every other, closed until clicked; lines are
                     built in code (see AddGameInfo). -->
                <local:FoldSection x:Name="GameInfo" Title="HOW GAME MODE WORKS" Margin="4,0,4,0">
                    <StackPanel x:Name="GameInfoLines" Margin="0,2,0,6"/>
                </local:FoldSection>
            </StackPanel>

            <Border Height="6" Background="Transparent"/>

            <!-- Reset All is hidden until Reset is tapped three times fast
                 (see ResetButton_Click) — a shortcut, not the only route:
                 Settings has a visible one too. -->
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="ResetButton" Content="Reset this mapping" Click="ResetButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0,12,0"/>
                <Button x:Name="ResetAllButton" Content="Reset every mapping" Click="ResetAllButton_Click" Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0,12,0" Margin="8,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
