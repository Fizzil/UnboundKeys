<UserControl x:Class="UnboundKeys.Wpf.SteeringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Steering (Fizzil, 2026-11-06, for racing games): the mouse as a
         steering wheel, one feature on one page. A short hint under each
         control; the long explanations live in Help. The switch is for the
         session and starts off; the stretch and the pushes are the
         app's, the same in every profile (see SteeringMap.cs). -->
    <StackPanel Margin="0,8,0,0">
        <!-- No switch here (Fizzil): the one way in is the one way out, a
             word, button or key with Starts and stops steering on in its
             editor. A switch on this page would hold the pointer in the
             band with no way back to it. So the page starts with the three
             places that switch lives, and says what is on and what
             switches it. This is what profiles are for (Fizzil): a racing
             profile holds the racing setup on the ordinary pages. -->
        <!-- The one-button way, ready made (Fizzil): Middle Button gets
             Throttle, Hold, Infinite and Starts and stops steering in the
             active profile, and the Mouse page opens on it. -->
        <Button x:Name="DefaultButton" Content="Default: Middle Button starts and stops racing, moving down brakes" Height="44" Margin="4,0,4,4" FontSize="13" Style="{StaticResource SecondaryButtonStyle}"/>
        <TextBlock Text="Or choose your own: open a mouse button, keyboard key or spoken word and switch on Starts and stops steering."
                   Style="{StaticResource RowHintStyle}"/>
        <UniformGrid Rows="1" Margin="4,0,4,6">
            <Button x:Name="GoMouseButton" Content="Mouse" Height="44" Margin="0,0,4,0" FontSize="13" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="GoKeyboardButton" Content="Keyboard" Height="44" Margin="2,0,2,0" FontSize="13" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="GoVoiceButton" Content="Voice" Height="44" Margin="4,0,0,0" FontSize="13" Style="{StaticResource SecondaryButtonStyle}"/>
        </UniformGrid>
        <TextBlock x:Name="StateText" FontSize="13" TextWrapping="Wrap" Margin="16,2,12,2"/>
        <TextBlock Text="Holds the pointer in the centre of the screen. The further you push left or right, the harder you turn. Stop pushing and the pointer springs back to the centre."
                   Style="{StaticResource RowHintStyle}"/>

        <Grid Height="44" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Stretch" Style="{StaticResource RowLabelStyle}"/>
            <TextBlock x:Name="StretchText" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="StretchMinusButton" Content="−5 %" Style="{StaticResource StepButtonStyle}"/>
                <Button x:Name="StretchPlusButton" Content="+5 %" Style="{StaticResource StepButtonStyle}"/>
                <Button x:Name="StretchResetButton" Content="Reset" Style="{StaticResource StepButtonStyle}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="How far the pointer can be pulled from the centre."
                   Style="{StaticResource RowHintStyle}"/>

        <!-- Push up and Push down: mappings pressed by pushing the pointer
             up or down the band, not by a button (see MouseCatalog.Pushes).
             Their rows are added in code. -->
        <TextBlock Text="MOVE MOUSE" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4"/>
        <TextBlock Text="Moving the mouse up or down can press a key or a pedal, such as the throttle or the brake."
                   Style="{StaticResource RowHintStyle}"/>
        <StackPanel x:Name="PushRows"/>

        <!-- The virtual controller, one line; the driver's download button
             only while it is missing (installed once). -->
        <TextBlock x:Name="PadDriverStatus" FontSize="13" TextWrapping="Wrap" Margin="16,12,12,2"/>
        <TextBlock x:Name="PadProblemText" Visibility="Collapsed" Style="{StaticResource RowHintStyle}" Margin="16,0,12,4"/>
        <Button x:Name="GetPadDriverButton" Content="Get the ViGEmBus driver (installed once)" Height="44" Margin="4,4,4,8" Padding="12,0,12,0" FontSize="13" Style="{StaticResource SecondaryButtonStyle}"/>
    </StackPanel>
</UserControl>
