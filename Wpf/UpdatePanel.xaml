<UserControl x:Class="UnboundKeys.Wpf.UpdatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The UPDATES section of Settings. A plain row until the button is
         clicked; then a card walks through confirm, checking, the result,
         download, unpack and start — in the page, never a Windows dialog
         (those take focus). The card's texts and buttons are set from
         code, one state at a time (see UpdatePanel.xaml.cs). -->
    <StackPanel>
        <Grid x:Name="IdleRow" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Asks Fizzil's GitHub for the newest release, only when you click. Nothing is checked on its own."
                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button x:Name="CheckButton" Grid.Column="1" Content="Check for updates" Width="150" Height="36" FontSize="13"
                    Margin="0,0,8,0" Style="{StaticResource ToggleFillButtonStyle}"/>
        </Grid>

        <Border x:Name="Card" Visibility="Collapsed" Margin="12,2,8,8" Padding="14,12,14,12" CornerRadius="6"
                Background="{DynamicResource ElevatedBrush}">
            <StackPanel>
                <TextBlock x:Name="Message" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="Detail" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Grid x:Name="Progress" Height="6" Margin="0,12,0,0" Visibility="Collapsed">
                    <Border CornerRadius="3" Background="{DynamicResource ButtonBrush}"/>
                    <Border x:Name="ProgressFill" CornerRadius="3" HorizontalAlignment="Left" Width="0"
                            Background="{DynamicResource AccentBrush}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="96"
                            Padding="14,0" Margin="0,0,8,0" FontSize="13"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButtonStyle}" Height="36" MinWidth="120"
                            Padding="16,0" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
