<UserControl x:Class="UnboundKeys.Wpf.KeyboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The dashboard's side of the on-screen keyboard: the switch that
         shows and hides it (DashboardShell owns the window), its size,
         and a map of the keyboard — the same rows the keyboard itself
         uses (KeyboardLayout) — where the remappable digits and letters
         are drawn as real keys you can click to remap, and everything
         else as a quiet outline. Fizzil's own idea: at a glance, the
         bright keys are the ones you can change. -->
    <StackPanel>
        <Button x:Name="ShowKeyboardToggle" Content="Show on-screen keyboard"
                Style="{StaticResource RailToggleStyle}" Margin="4,4,4,0"/>
        <TextBlock Text="Drag it by the handle on its left edge. Mini collapses it to a single strip; Maxi brings it back."
                   FontSize="11" TextWrapping="Wrap" Margin="16,0,12,4" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- Small is about the footprint of Windows' own on-screen
             keyboard (the one this replaces); Large is the full-size
             layout. Applied live to an open keyboard. -->
        <Grid Height="44" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Keyboard size" Style="{StaticResource RowLabelStyle}"/>
            <Border Grid.Column="1" Style="{StaticResource SegmentGroupStyle}" Margin="0,0,8,0">
                <UniformGrid Rows="1" Width="270">
                    <Button x:Name="SmallSizeButton" Content="Small" Click="SizeButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                    <Button x:Name="MediumSizeButton" Content="Medium" Click="SizeButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                    <Button x:Name="LargeSizeButton" Content="Large" Click="SizeButton_Click" Style="{StaticResource SegmentButtonStyle}"/>
                </UniformGrid>
            </Border>
        </Grid>

        <TextBlock Text="KEYS" Style="{StaticResource SectionHeaderStyle}" Margin="4,14,0,2"/>
        <TextBlock Text="The bright keys are the ones you can remap — click one. A key that's been changed shows what it sends now."
                   FontSize="11" TextWrapping="Wrap" Margin="12,0,12,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <StackPanel x:Name="KeyRows" Margin="2,0,2,0"/>
    </StackPanel>
</UserControl>
