<UserControl x:Class="UnboundKeys.Wpf.KeyboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The dashboard's side of the on-screen keyboard: a switch to show
         it (wired up when the keyboard itself is ported — Stage B) and
         every remappable key as a tile, so remapping happens here by
         left-click instead of by right-clicking a key on the keyboard
         (a right button that's been remapped can't right-click anything
         in this app, the hook swallows it). -->
    <StackPanel>
        <TextBlock Text="The on-screen keyboard sends keys to your game with the mouse. Any of its letter and number keys can be remapped — click one below."
                   FontSize="12" TextWrapping="Wrap" Margin="12,4,12,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Button x:Name="ShowKeyboardToggle" Content="Show on-screen keyboard" IsEnabled="False"
                Style="{StaticResource RailToggleStyle}" Margin="4,0,4,0"/>
        <TextBlock Text="Coming with the keyboard port — until then the keyboard still opens from the current dashboard."
                   FontSize="11" TextWrapping="Wrap" Margin="16,0,12,4" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <TextBlock Text="KEYS" Style="{StaticResource SectionHeaderStyle}" Margin="4,12,0,4"/>
        <UniformGrid x:Name="KeyGrid" Columns="9"/>
    </StackPanel>
</UserControl>
