<Window x:Class="UnboundKeys.Wpf.ProfilesTabPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase 6 preview — ProfilesTab"
        Width="420" SizeToContent="Height"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <StackPanel x:Name="Root" Margin="20">
        <TextBlock Text="Real card, real data. Add a profile, switch to it, delete it — all real Settings/KeyMap calls."
                   Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
    </StackPanel>
</Window>
