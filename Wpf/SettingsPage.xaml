<UserControl x:Class="UnboundKeys.Wpf.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnboundKeys.Wpf">
    <!-- Everything that used to hide behind a gesture on the overlay icon
         (the color picker was four quick right-clicks) or live as its own
         tab (Profile), as plain visible controls. Each section folds under
         its heading (FoldSection) and, closed, carries a one-line summary
         of its state set from code — Fizzil: the page was getting long,
         and a closed row that still reads "Red" loses nothing. -->
    <StackPanel>
        <local:FoldSection x:Name="ThemeFold" Title="THEME">
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="4,2,0,8"/>
        </local:FoldSection>

        <local:FoldSection x:Name="ProfilesFold" Title="PROFILES">
            <StackPanel>
                <TextBlock Text="A profile is a game: its colour, plus up to ten sub-profiles that each hold a complete set of mappings. Click a profile to show its sub-profiles, and a sub-profile to switch to it."
                           FontSize="12" TextWrapping="Wrap" Margin="12,0,12,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="ProfileList"/>
                <local:NameKeyboard x:Name="NameGrid" Visibility="Collapsed" Margin="8,4,8,8"/>
            </StackPanel>
        </local:FoldSection>

        <local:FoldSection x:Name="StartupFold" Title="STARTUP">
            <StackPanel>
                <Button x:Name="StartWithWindowsToggle" Content="Start with Windows" Style="{StaticResource RailToggleStyle}" Margin="4,0,4,0"/>
                <TextBlock x:Name="StartupHint"
                           FontSize="11" TextWrapping="Wrap" Margin="16,0,12,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button x:Name="AutoStartPausedToggle" Content="Start with voice keys paused" Style="{StaticResource RailToggleStyle}" Margin="4,0,4,0"/>
                <TextBlock Text="Only for that automatic start. Flip Listening on when you are ready to play; a launch by hand always comes up listening."
                           FontSize="11" TextWrapping="Wrap" Margin="16,0,12,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </local:FoldSection>

        <local:FoldSection x:Name="UpdatesFold" Title="UPDATES">
            <local:UpdatePanel x:Name="Updates"/>
        </local:FoldSection>

        <!-- The action logger (see Log.cs): for debugging and for building
             new features. The user's choice, off unless switched on here,
             and its own section rather than a line under About (Fizzil). -->
        <local:FoldSection x:Name="LoggerFold" Title="ACTION LOGGER">
            <StackPanel>
                <Button x:Name="WriteLogToggle" Content="Action logger" Style="{StaticResource RailToggleStyle}" Margin="4,0,4,0"/>
                <TextBlock Text="Off by default. Used for debugging and for building new features: while it is on, the app notes its starts, errors and the changes you make in this dashboard (a mapping's keys or mode, the profile) in a text file on this PC. While it is off, nothing is written."
                           FontSize="11" TextWrapping="Wrap" Margin="16,0,12,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Grid Height="44" Margin="4,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="The log file sits beside your settings." FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="OpenLogButton" Grid.Column="1" Content="Open log folder" Height="36" Padding="12,0,12,0" FontSize="13" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </StackPanel>
        </local:FoldSection>

        <!-- Two resets (Fizzil): the active profile's mappings, and the
             whole app back to a fresh install. Each button asks "Are you
             sure?" before its second click acts (ConfirmDeleteBehavior). -->
        <local:FoldSection x:Name="ResetFold" Title="RESET">
            <StackPanel>
                <Grid MinHeight="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,4,12,4"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Reset your active profile" Foreground="{DynamicResource TextPrimaryBrush}"/><LineBreak/><Run Text="Every mouse, voice and keyboard mapping in its current sub-profile goes back to default."/>
                    </TextBlock>
                    <Button x:Name="ResetAllButton" Grid.Column="1" Content="Reset profile" Width="120" Height="36" FontSize="13"
                            Margin="0,0,8,0" Style="{StaticResource ToggleFillButtonStyle}"/>
                </Grid>
                <Grid MinHeight="48" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,4,12,4"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Reset the entire app" Foreground="{DynamicResource TextPrimaryBrush}"/><LineBreak/><Run Text="Every profile, setting, kept word and log entry is deleted, and the app starts again as new. This cannot be undone."/>
                    </TextBlock>
                    <Button x:Name="ResetAppButton" Grid.Column="1" Content="Reset app" Width="120" Height="36" FontSize="13"
                            Margin="0,0,8,0" Style="{StaticResource ToggleFillButtonStyle}"/>
                </Grid>
            </StackPanel>
        </local:FoldSection>

        <local:FoldSection x:Name="QuitFold" Title="QUIT">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stops UnboundKeys completely, releasing anything held. Closing this window only hides it. Click twice to confirm."
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button x:Name="QuitButton" Grid.Column="1" Content="Quit" Width="120" Height="36" FontSize="13"
                        Margin="0,0,8,0" Style="{StaticResource ToggleFillButtonStyle}"/>
            </Grid>
        </local:FoldSection>

        <local:FoldSection x:Name="AboutFold" Title="ABOUT">
            <StackPanel>
                <TextBlock x:Name="AboutText" FontSize="12" Margin="12,0,12,8" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </local:FoldSection>
    </StackPanel>
</UserControl>
