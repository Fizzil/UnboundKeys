<UserControl x:Class="UnboundKeys.Wpf.VoiceDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Voice page's picture: Fizzil's own line-art profile
         (Assets/voice-profile.png, 516×457) painted in the text color
         through a mask made from it at load time (see the code-behind),
         so the strokes sit straight on the dark background and re-color
         with the theme. Sound waves from her mouth come up to full
         strength while a tile is hovered. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="260" Height="195">

            <Rectangle Canvas.Left="0" Canvas.Top="8" Width="200" Height="177"
                       Fill="{DynamicResource TextPrimaryBrush}" Opacity="0.92">
                <Rectangle.OpacityMask>
                    <ImageBrush x:Name="ProfileMask" Stretch="Uniform"/>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- sound waves, from the lips -->
            <Path x:Name="Waves" Data="M 193.5,101 A 14,14 0 0 1 193.5,117 M 201.7,95.2 A 24,24 0 0 1 201.7,122.8 M 209.9,89.5 A 34,34 0 0 1 209.9,128.5"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        </Canvas>
    </Viewbox>
</UserControl>
