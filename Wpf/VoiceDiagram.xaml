<UserControl x:Class="UnboundKeys.Wpf.VoiceDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Voice page's picture: a woman in profile, speaking, drawn as
         thin line art after the sketch Fizzil pointed at — a low crown
         with the hair flowing back almost level, a small upturned nose, a
         cupid's-bow mouth, a small rounded chin and a soft jaw into a
         slender neck; no filled shape. Sound waves from her mouth, and
         below, a key being pressed whose label follows the hovered row,
         so the picture reads "say this, and this gets pressed". Strokes
         only, in the text colors, so it re-themes with everything else. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="300">

            <!-- profile: forehead, brow, nose, lips, chin, jaw, throat -->
            <Path Data="M 108,70 C 118,74 126,86 128,98 C 128,101 128,105 129,108 C 133,113 139,119 140,124 C 141,127 139,129 135,129 C 133,129 132,132 133,134 C 135,136 138,138 138,141 C 138,143 136,144 134,144 C 138,146 139,150 137,152 C 136,154 134,156 134,157 C 138,159 139,164 136,167 C 132,176 120,182 108,182 C 106,192 106,208 110,222"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Opacity="0.85"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <!-- back of the neck -->
            <Path Data="M 84,182 C 82,196 80,212 78,228"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4" Opacity="0.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- brow, closed eye, lashes -->
            <Path Data="M 110,94 C 116,90 124,90 130,93"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4" Opacity="0.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 114,109 C 118,106 124,106 129,109 M 129,109 L 132,112 M 126,109.5 L 128,113"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Opacity="0.85"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- hair: a low crown flowing back, strands sweeping back and
                 down, a fringe piece at the temple -->
            <Path Data="M 108,70 C 96,58 78,56 62,64 C 50,70 44,84 44,100 C 44,120 34,140 20,156"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Opacity="0.65"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 106,72 C 100,84 98,96 100,108"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3" Opacity="0.55"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 112,68 C 98,76 88,96 88,122 C 88,146 78,166 60,182"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3" Opacity="0.55"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 90,70 C 78,88 74,116 78,146 C 82,176 88,204 82,236 C 80,248 76,258 68,268"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3" Opacity="0.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 62,64 C 48,82 44,104 50,128 C 54,150 46,172 34,190"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 44,100 C 36,120 26,138 8,150"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 88,122 C 72,136 52,146 30,146"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 60,182 C 52,194 40,202 26,206"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- sound waves, from the lips -->
            <Path x:Name="Waves" Data="M 158,129.4 A 22,22 0 0 1 158,154.6 M 169.5,121.3 A 36,36 0 0 1 169.5,162.7 M 181,113.3 A 50,50 0 0 1 181,170.7"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- the key: one cap, with its underside showing as a soft
                 lip below rather than a second outlined box -->
            <Rectangle Canvas.Left="132" Canvas.Top="218" Width="54" Height="44" RadiusX="6" RadiusY="6"
                       Fill="{DynamicResource HoverBrush}"/>
            <Rectangle Canvas.Left="132" Canvas.Top="214" Width="54" Height="44" RadiusX="6" RadiusY="6"
                       Fill="{DynamicResource ElevatedBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1"/>
            <TextBlock x:Name="KeyLabel" Canvas.Left="132" Canvas.Top="214" Width="54" Height="44" Padding="4,13,4,0"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Canvas>
    </Viewbox>
</UserControl>
