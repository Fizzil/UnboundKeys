<UserControl x:Class="UnboundKeys.Wpf.VoiceDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Voice page's picture: a woman in profile, speaking, drawn as
         thin line art (the style Fizzil pointed at — a few flowing
         strokes, no filled shape), sound waves from her mouth, and below,
         a key being pressed whose label follows the hovered row, so the
         picture reads "say this, and this gets pressed". Strokes only, in
         the text colors, so it re-themes with everything else. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="300">

            <!-- profile: forehead, brow, nose, lips, chin, jaw, throat -->
            <Path Data="M 112,52 C 122,58 131,72 132,88 C 132,92 131,96 132,100 C 138,108 148,118 150,126 C 151,130 148,133 143,133 C 140,133 139,136 140,139 C 142,141 145,143 145,147 C 145,149 142,150 140,150 C 144,152 145,157 143,160 C 141,163 139,165 139,166 C 144,169 145,175 142,178 C 136,186 122,194 110,196 C 108,208 110,224 114,236"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Opacity="0.85"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <!-- back of the neck -->
            <Path Data="M 84,196 C 82,210 80,224 78,238"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4" Opacity="0.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- brow, closed eye, one lash -->
            <Path Data="M 114,84 C 120,80 128,80 134,83"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4" Opacity="0.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 118,101 C 122,98 128,98 133,101 M 133,101 L 136,104"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Opacity="0.85"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- hair: the crown, then strands sweeping back and down, with
                 a fringe piece falling at the temple -->
            <Path Data="M 112,52 C 100,38 76,36 60,50 C 46,62 40,84 42,108 C 44,130 34,150 22,168"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Opacity="0.65"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 110,54 C 104,66 100,80 100,96"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3" Opacity="0.55"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 116,50 C 100,58 88,82 86,110 C 84,140 74,166 56,186"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3" Opacity="0.55"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 96,60 C 82,80 78,110 80,140 C 82,170 88,200 82,236 C 80,250 76,262 68,274"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3" Opacity="0.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 60,50 C 48,72 44,98 48,124 C 52,150 44,176 30,196"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 42,108 C 36,132 26,150 8,164"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 86,110 C 70,130 50,142 28,144"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 56,186 C 48,200 36,208 22,212"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" Opacity="0.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- sound waves, from the lips -->
            <Path x:Name="Waves" Data="M 164,135.4 A 22,22 0 0 1 164,160.6 M 175.5,127.3 A 36,36 0 0 1 175.5,168.7 M 187,119.3 A 50,50 0 0 1 187,176.7"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- the key: one cap, with its underside showing as a soft
                 lip below rather than a second outlined box -->
            <Rectangle Canvas.Left="132" Canvas.Top="218" Width="54" Height="44" RadiusX="6" RadiusY="6"
                       Fill="{DynamicResource HoverBrush}"/>
            <Rectangle Canvas.Left="132" Canvas.Top="214" Width="54" Height="44" RadiusX="6" RadiusY="6"
                       Fill="{DynamicResource ElevatedBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1"/>
            <TextBlock x:Name="KeyLabel" Canvas.Left="132" Canvas.Top="214" Width="54" Height="44" Padding="4,13,4,0"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Canvas>
    </Viewbox>
</UserControl>
