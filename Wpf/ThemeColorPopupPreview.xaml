<local:NoActivateWindow x:Class="UnboundKeys.Wpf.ThemeColorPopupPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnboundKeys"
        Title="Phase 5 preview — ThemeColorPopup"
        Width="260" Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="400" Top="200">
    <local:NoActivateWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.Red.xaml"/>
                <ResourceDictionary Source="../Themes/Theme.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:NoActivateWindow.Resources>
    <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
        <StackPanel Margin="12">
            <TextBlock Text="Stand-in for the overlay icon (4-rapid-right-click gesture comes with OverlayForm, Phase 8) — click below to open the picker under it."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button x:Name="IconStandIn" Content="Icon" Height="60" Width="60" HorizontalAlignment="Left"
                    Click="IconStandIn_Click" Style="{StaticResource ListButtonStyle}"/>
            <TextBlock x:Name="ResultText" Foreground="{DynamicResource AccentBrush}" FontSize="13"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</local:NoActivateWindow>
