<local:NoActivateWindow x:Class="UnboundKeys.Wpf.CategoryKeyPopupPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnboundKeys"
        Title="Phase 4 preview — CategoryKeyPopup"
        Width="260" Height="220"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="400" Top="200">
    <local:NoActivateWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.Red.xaml"/>
                <ResourceDictionary Source="../Themes/Theme.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:NoActivateWindow.Resources>
    <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
        <StackPanel Margin="12">
            <TextBlock Text="Stand-in for a real Key card's category row — click one, the popup should open to its LEFT, not overlapping."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button x:Name="LettersButton" Content="Letters" Height="34" Margin="0,0,0,1"
                    Click="CategoryButton_Click" Style="{StaticResource NestedButtonStyle}"/>
            <Button x:Name="NumbersButton" Content="Numbers" Height="34" Margin="0,0,0,1"
                    Click="CategoryButton_Click" Style="{StaticResource NestedButtonStyle}"/>
            <Button x:Name="ModifiersButton" Content="Modifiers" Height="34"
                    Click="CategoryButton_Click" Style="{StaticResource NestedButtonStyle}"/>
            <TextBlock x:Name="ResultText" Foreground="{DynamicResource AccentBrush}" FontSize="13"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</local:NoActivateWindow>
