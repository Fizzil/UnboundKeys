<UserControl x:Class="UnboundKeys.Wpf.ProfilesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="370">
    <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" CornerRadius="8"
            Effect="{StaticResource CardShadow}">
        <StackPanel Margin="1">

            <!-- "Profiles" heading + rule — the new Windows-folder-
                 properties-style grouping Fizzil pointed at, used for
                 real here for the first time (StyleGallery only ever
                 demoed it). -->
            <TextBlock Text="Profiles" Margin="12,10,12,2" Style="{StaticResource SectionHeaderStyle}"/>
            <Border Margin="12,0,12,4" Style="{StaticResource SectionRuleStyle}"/>

            <!-- Add Profile, the inline naming row (only while expanded),
                 and every existing profile — all built dynamically in
                 code (see RebuildList) since the count and naming-row
                 visibility both vary. Matches ProfilesTab.cs's own
                 RebuildProfilesList (WinForms). -->
            <StackPanel x:Name="ProfileList"/>

        </StackPanel>
    </Border>
</UserControl>
