<UserControl x:Class="UnboundKeys.Wpf.NameKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mouse-only text entry for a profile or sub-profile name: the name
         so far, then a QWERTY keyboard in the on-screen keyboard's key
         style (Fizzil found the old alphabet grid hard to use), trimmed to
         what a name needs so every key stays a big target, then Cancel and
         Done. Rows are built in code (see NameKeyboard.xaml.cs). This is
         the one place in the app that takes text, and it never needs
         keyboard focus, so the dashboard can keep never stealing it from
         a game. -->
    <StackPanel>
        <Grid Height="44" Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="6" Background="{DynamicResource ElevatedBrush}"/>
            <TextBlock x:Name="PlaceholderText" Text="Type a name with the keys below" FontSize="13"
                       Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="PreviewText" Style="{StaticResource PageTitleStyle}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Width="90" Height="40" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="DoneButton" Grid.Column="2" Content="Done" Width="90" Height="40" Margin="6,0,0,0" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
        <StackPanel x:Name="Rows"/>
    </StackPanel>
</UserControl>
