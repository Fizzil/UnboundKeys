<Window x:Class="UnboundKeys.Wpf.RemapCardPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase 6 preview — RemapCard (Key row + action row)"
        Width="420" SizeToContent="Height"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <StackPanel x:Name="Root" Margin="20">
        <TextBlock Text="Real card, real data — bound to voice word &quot;one&quot;. Click the key value to expand categories, hover a category to pick a key, Repeat/Hold to toggle, Reset to really reset it."
                   Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
    </StackPanel>
</Window>
